---
// Static build: the search page is a prerendered shell. There is no server to
// run the FTS query at request time, so results are fetched client-side from
// the backend's same-origin search API (/_emdash/api/search) and rendered by
// the inline script below. The <form> still works without JS (it reloads the
// page with ?q=…); the script upgrades it to fetch-and-render in place.
import Base from "../layouts/Base.astro";
---

<Base title="Search" description="Search blog posts">
	<section class="search-page">
		<h1 class="search-title">Search</h1>

		<form method="get" action="/search" class="search-form" id="search-form">
			<input
				type="search"
				name="q"
				placeholder="Search posts..."
				class="search-input"
				id="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">Search</button>
		</form>

		<p class="search-summary" id="search-summary" hidden></p>

		<ol class="search-results" id="search-results" hidden></ol>

		<p class="search-hint" id="search-hint">Enter a search term to find posts.</p>
	</section>
</Base>

<script is:inline>
	(function () {
		const form = document.getElementById("search-form");
		const input = document.getElementById("search-input");
		const summary = document.getElementById("search-summary");
		const results = document.getElementById("search-results");
		const hint = document.getElementById("search-hint");

		function currentQuery() {
			const params = new URLSearchParams(window.location.search);
			return (params.get("q") || "").trim();
		}

		function escapeHtml(str) {
			return String(str)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		function setSummary(text) {
			summary.textContent = text;
			summary.hidden = !text;
		}

		function render(query, items) {
			results.innerHTML = "";
			if (!items.length) {
				results.hidden = true;
				setSummary(`No results for "${query}"`);
				return;
			}
			setSummary(
				`${items.length} result${items.length === 1 ? "" : "s"} for "${query}"`
			);
			for (const item of items) {
				const li = document.createElement("li");
				li.className = "search-result";
				const href = `/posts/${item.slug ?? item.id}`;
				const title = escapeHtml(item.title ?? "Untitled");
				// Snippets returned by /api/search are already sanitised.
				const snippet = item.snippet
					? `<p class="result-snippet">${item.snippet}</p>`
					: "";
				li.innerHTML = `<a href="${href}" class="result-link"><h2 class="result-title">${title}</h2>${snippet}</a>`;
				results.appendChild(li);
			}
			results.hidden = false;
		}

		async function run(query) {
			document.title = query ? `Search: ${query} — ${document.title.split("—").pop().trim()}` : document.title;
			if (input) input.value = query;
			if (!query) {
				hint.hidden = false;
				results.hidden = true;
				setSummary("");
				return;
			}
			hint.hidden = true;
			setSummary("Searching…");
			try {
				const params = new URLSearchParams({
					q: query,
					collections: "posts",
					limit: "30",
				});
				const res = await fetch(`/_emdash/api/search?${params}`, {
					headers: { Accept: "application/json" },
				});
				if (!res.ok) throw new Error(`search failed: ${res.status}`);
				const body = await res.json();
				const data = body.data || body;
				const items = data.items || data.results || [];
				render(query, items);
			} catch (err) {
				results.hidden = true;
				setSummary(`Could not load results for "${query}".`);
			}
		}

		// Intercept submit so we update the URL and fetch without a full reload.
		if (form) {
			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const q = (input && input.value ? input.value : "").trim();
				const url = q
					? `${window.location.pathname}?q=${encodeURIComponent(q)}`
					: window.location.pathname;
				window.history.replaceState(null, "", url);
				run(q);
			});
		}

		run(currentQuery());
	})();
</script>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.search-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-brand);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 500;
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.search-summary {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.search-hint {
		color: var(--color-muted);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:first-child {
		padding-top: 0;
	}

	.search-result:last-child {
		border-bottom: none;
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}
</style>
